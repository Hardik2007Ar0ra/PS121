# ---------------------------------------------------------------------------
# NWIS configuration. Copy to `.env` and fill in.
# Every value below is the built-in default, so an empty `.env` still runs.
# Values marked REQUIRED have no safe production default and are validated at
# boot by server/config.js when NODE_ENV=production.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated allowlist. REQUIRED in production — do not use `true`.
CORS_ORIGIN=http://localhost:5173

# --- Auth ------------------------------------------------------------------
# REQUIRED in production. Startup fails if unset while NODE_ENV=production.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10

# --- Database --------------------------------------------------------------
# SQLite (default, zero-dependency demo path)
#   NWIS_DB_PATH=./nwis.sqlite
# Set to a path to persist across restarts; unset = in-memory every boot.
NWIS_DB_PATH=./nwis.sqlite

# PostgreSQL + PostGIS + pgvector (production target). See
# docs/DATA_MODEL.md for the schema and README for how to switch.
# DATABASE_URL=postgres://nwis:nwis@localhost:5432/nwis

# Where uploaded PDFs and rendered page images live.
NWIS_STORAGE_DIR=./storage

# --- Seeding ---------------------------------------------------------------
# Regenerate the synthetic corpus on boot. Set false once real data is loaded,
# otherwise the generator will repopulate empty tables on every restart.
NWIS_AUTO_SEED=true
NWIS_SEED_DETERMINISTIC=true
# Master RNG seed — same seed produces byte-identical corpora.
NWIS_SEED=20260101

# Corpus size. Defaults are sized for a fast demo; raise for a realistic set.
NWIS_N_WELLS=48
NWIS_N_FIELDS=3
NWIS_DOCS_PER_WELL=0.6
NWIS_TELEMETRY_POINTS=260

# --- Ingestion / OCR / NLP -------------------------------------------------
# Upload limits
NWIS_MAX_UPLOAD_BYTES=26214400
# Extracted facts below this confidence go to the human review queue instead of
# being written straight into the knowledge base.
NWIS_OCR_MIN_CONFIDENCE=0.72
# Per-page text shorter than this many characters is treated as an image-only
# page and routed to OCR.
NWIS_OCR_TEXT_THRESHOLD=40
# 'auto' | 'text' | 'ocr' | 'off'   (auto = try text layer, fall back to OCR)
NWIS_OCR_MODE=auto
# Tesseract language packs. eng is small; add hin/asm for regional reports.
NWIS_OCR_LANGS=eng
# OCR is lazily loaded and degrades gracefully when unavailable.
NWIS_OCR_ENABLED=true

# --- eRTMAC / live telemetry ----------------------------------------------
# 'simulator' | 'file' | 'off'
NWIS_LIVE_SOURCE=simulator
# Replay speed multiplier for the file/simulator source.
NWIS_LIVE_INTERVAL_MS=2000
# Stale-feed threshold in seconds. Alerts are suppressed while data is stale.
NWIS_LIVE_STALE_SECONDS=180
NWIS_ERTTMAC_BASE_URL=
NWIS_ERTTMAC_MQTT_URL=

# --- Machine learning ------------------------------------------------------
# Directory for versioned model artifacts + model cards (committed to git).
NWIS_ML_ARTIFACTS_DIR=./ml/artifacts
# Require trained artifacts at boot instead of falling back to the bundled
# heuristic model. Turn on in production so a model version is always cited.
NWIS_ML_REQUIRE_TRAINED=false
# Dimensions of stored document-chunk embeddings.
NWIS_EMBEDDING_DIM=256

# --- Generative assistant (optional) --------------------------------------
# The assistant is fully functional without this. When unset, the deterministic
# extractive summariser answers instead, and it never fabricates.
# 'ollama' | 'openai-compatible' | 'none'
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
# Retrieval settings for the grounded assistant.
NWIS_RAG_TOP_K=8
NWIS_RAG_MIN_SCORE=0.15

# --- Logging ---------------------------------------------------------------
# 'silent' | 'error' | 'warn' | 'info' | 'debug'
NWIS_LOG_LEVEL=info