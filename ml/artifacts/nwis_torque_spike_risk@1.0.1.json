    "validation": {
      "method": "4-fold cross-validation grouped by well",
      "rationale": "Rows are split by well, never at random. Adjacent metres of one hole share their own neighbourhood in the rolling features and the same rock, so a random row split leaks the well into the training set and reports a number that does not survive the next well.",
      "folds": 4
    },
    "expectedFeatures": [
      "torque_ratio_local",
